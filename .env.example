# このファイルを .env にコピーして値を設定してください（.env は git 管理対象外）
# GitHub Actions で実行する場合は、同じキー名で Repository Secrets に登録します。

# --- 台本生成（Anthropic Claude） ---
ANTHROPIC_API_KEY=

# --- 音声合成（TTS） ---
# TTS_PROVIDER: "gtts"（無料・APIキー不要） または "elevenlabs"（高品質・有料）
TTS_PROVIDER=gtts
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- YouTube アップロード（Google OAuth2） ---
# YouTube Data API v3 の OAuth クライアントとリフレッシュトークン
# 取得手順は README.md の「YouTube アップロードのセットアップ」を参照
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# アップロード時の公開設定: public / unlisted / private
YOUTUBE_PRIVACY_STATUS=private

# --- 動作モード ---
# true にすると実際のアップロード・API呼び出しを行わずログのみ出力する
DRY_RUN=true
